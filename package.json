{
  "name": "dsa-zotero-sidebar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "在 DeepSeek Harness 中浏览、搜索并引用 Zotero 文献库：better-sidebar 右侧栏文件树、双击/& 与 /zotero 快速引用、host 直读 zotero.sqlite",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.0.1"
  },
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json && tsdown",
    "typecheck": "tsc --noEmit",
    "bundle": "tsdown",
    "pack": "pnpm pack"
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.7",
    "dsh-better-sidebar": "0.10.3"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": {
      "optional": true
    },
    "cordis": {
      "optional": true
    }
  },
  "dependencies": {
    "@pierre/trees": "1.0.0-beta.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "dsh-better-sidebar": "0.10.3",
    "lightningcss": "^1.29.0",
    "react": "^19.0.0",
    "tsdown": "^0.22.3",
    "typescript": "^5.7.0"
  }
}
